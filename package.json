{
  "name": "poller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:assets && concurrently -n assets,worker \"pnpm watch:assets\" \"wrangler dev\"",
    "dev:convex": "convex dev",
    "build:assets": "node scripts/build-assets.mjs",
    "watch:assets": "node scripts/build-assets.mjs --watch",
    "build": "pnpm build:assets && wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm build:assets && convex deploy -y && wrangler deploy",
    "admin:create": "node scripts/create-admin.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit -p convex && tsc --noEmit -p client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.4.3",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "convex": "^1.49.0",
    "express": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@nestjs/testing": "^12.4.2",
    "@tailwindcss/cli": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "convex-test": "^0.0.69",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0"
}
